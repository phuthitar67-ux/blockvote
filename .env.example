# --- Hardhat deploy config (server-side only, never commit real values) ---

# RPC endpoint for Sepolia, e.g. from Alchemy or Infura. Used by Hardhat to
# submit the deploy transactions and by any `--network sepolia` command.
SEPOLIA_RPC_URL=

# Private key of the deployer wallet, funded with Sepolia test ETH. This is
# the account that pays gas for and owns the deployment. No 0x prefix needed
# (with or without both work). Use a dedicated test wallet, never a wallet
# holding real funds.
PRIVATE_KEY=

# API key from etherscan.io (free tier is enough). Only needed if you want to
# run `npx hardhat verify --network sepolia <address> [constructorArgs]` to
# publish the contract source on Sepolia Etherscan. Not required to deploy.
ETHERSCAN_API_KEY=

# --- Frontend config (exposed to the browser, fill after deploy) ---
NEXT_PUBLIC_GOV_TOKEN_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=
